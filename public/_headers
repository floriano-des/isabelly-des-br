# O Cloudflare só deve medir desempenho após o aceite. Evita a inserção automática do beacon no HTML, inclusive nas páginas de erro.
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# As mídias e os arquivos estáticos conservam a política de cache e compressão do site.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate
/media/*
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate
/cursor/*
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate
/cv/*
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate
/og/*
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate
