---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsPreferences from '../components/AnalyticsPreferences.astro';
import shareCards from '../data/open-graph.json';
import { copy, pathFor, description, socials, type Lang, type Section, type Project } from '../lib/site';
import displayFont from '@fontsource/pirata-one/files/pirata-one-latin-400-normal.woff2?url';
import sansFont from '@fontsource/urbanist/files/urbanist-latin-400-normal.woff2?url';
import '../styles/site.css';
type Props = { lang: Lang } & (
  | { section: 'case'; project: Project }
  | { section: Exclude<Section, 'case'>; project?: never }
);
const { lang, section, project } = Astro.props;
const t = copy[lang];
const pageName = section === 'case' ? project.titulo[lang] : t[section];
const title =
  section === 'home'
    ? lang === 'pt'
      ? 'Isabelly Lima · Designer gráfica e ilustradora'
      : 'Isabelly Lima · Graphic designer and illustrator'
    : project?.tipo === 'marca'
      ? `${pageName} · ${project.categoria[lang]} · Isabelly Lima`
      : `${pageName} · Isabelly Lima`;
const desc = description(lang, section, project);
const absolute = (path: string) => new URL(path, Astro.site).href;
const pagePath = pathFor(lang, section, project?.slug);
const canonical = absolute(pagePath);
const socialOrigin = process.env.SOCIAL_PREVIEW_ORIGIN || Astro.site;
const socialUrl = new URL(pagePath, socialOrigin).href;
const cardKey = project?.slug ?? section;
const cards: Record<string, { image: string; alt: string }> = shareCards[lang];
const card = cards[cardKey];
if (!card) throw new Error(`Cartão de compartilhamento ausente: ${lang}/${cardKey}. Execute npm run media.`);
const image = new URL(card.image, socialOrigin).href;
const person = {
  '@type': 'Person',
  '@id': absolute('/#isabelly'),
  name: 'Isabelly Lima',
  jobTitle: lang === 'pt' ? 'Designer gráfica e ilustradora' : 'Graphic designer and illustrator',
  url: absolute('/'),
  sameAs: Object.values(socials),
};
const structured =
  section === 'case'
    ? {
        '@type': 'CreativeWork',
        name: project?.titulo[lang],
        description: desc,
        inLanguage: lang,
        image,
        url: canonical,
        creator: person,
      }
    : person;
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en-GB'} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#13071D" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {section === 'error' && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    {(['pt', 'en'] as const).map((l) => (
      <link
        rel="alternate"
        hreflang={l === 'pt' ? 'pt-BR' : 'en-GB'}
        href={absolute(pathFor(l, section, project?.slug))}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(pathFor('pt', section, project?.slug))} />
    <meta property="og:type" content={section === 'case' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Isabelly Lima" />
    <meta property="og:url" content={socialUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_GB' : 'pt_BR'} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={card.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={card.alt} />
    <link rel="icon" href="/cursor/gato.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="preload" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansFont} crossorigin />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', ...structured }).replace(
        /</g,
        '\\u003c',
      )}
    ></script>
    <ClientRouter fallback="swap" />
  </head>
  <body data-lang={lang} data-page={section}>
    <a class="skip" href="#conteudo">
      {t.skip}
    </a>
    <AnalyticsPreferences {lang} />
    <Header {lang} {section} slug={project?.slug} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer {lang} {section} />
    <div class="page-curtain" aria-hidden="true">
      <img src="/cursor/gato-lavanda.svg" alt="" width="68" height="70" />
    </div>
    <div class="cat-cursor" aria-hidden="true">
      <span class="cursor-shape"></span>
      <span class="cursor-label"></span>
    </div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
