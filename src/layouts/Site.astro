---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy, pathFor, description, socials, type Lang, type Section, type Project } from '../lib/site';
import displayFont from '@fontsource/pirata-one/files/pirata-one-latin-400-normal.woff2?url';
import sansFont from '@fontsource/urbanist/files/urbanist-latin-400-normal.woff2?url';
import '../styles/site.css';
interface Props {
  lang: Lang;
  section: Section;
  project?: Project;
}
const { lang, section, project } = Astro.props;
const t = copy[lang];
const pageName = section === 'case' ? project?.titulo[lang] : section === 'error' ? t.error : t[section];
const title =
  section === 'home'
    ? lang === 'pt'
      ? 'Isabelly Lima · Designer gráfica e ilustradora'
      : 'Isabelly Lima · Graphic designer and illustrator'
    : pageName + ' · Isabelly Lima';
const desc = description(lang, section, project);
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(pathFor(lang, section, project?.slug));
const image = absolute('/og/' + lang + '/' + (project?.slug ?? section) + '.jpg');
const person = {
  '@type': 'Person',
  '@id': absolute('/#isabelly'),
  name: 'Isabelly Lima',
  jobTitle: lang === 'pt' ? 'Designer gráfica e ilustradora' : 'Graphic designer and illustrator',
  url: absolute('/'),
  sameAs: Object.values(socials),
};
const structured =
  section === 'case'
    ? {
        '@type': 'CreativeWork',
        name: project?.titulo[lang],
        description: desc,
        inLanguage: lang,
        image,
        url: canonical,
        creator: person,
      }
    : person;
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en-GB'} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#13071D" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {section === 'error' && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    {(['pt', 'en'] as const).map((l) => (
      <link
        rel="alternate"
        hreflang={l === 'pt' ? 'pt-BR' : 'en-GB'}
        href={absolute(pathFor(l, section, project?.slug))}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(pathFor('pt', section, project?.slug))} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_GB'} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/cursor/gato.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="preload" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansFont} crossorigin />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', ...structured }).replace(
        /</g,
        '\\u003c',
      )}
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      if (!window.__isaGtm && !['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)) {
        window.__isaGtm = true;
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        const gtm = document.createElement('script');
        gtm.async = true;
        gtm.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-PJGH2MT6';
        document.head.append(gtm);
      }
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body data-lang={lang} data-page={section}>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PJGH2MT6"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>
    <a class="skip" href="#conteudo">
      {t.skip}
    </a>
    <Header {lang} {section} slug={project?.slug} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer {lang} {section} />
    <div class="page-curtain" aria-hidden="true">
      <img src="/cursor/gato-lavanda.svg" alt="" width="68" height="70" />
    </div>
    <div class="cat-cursor" aria-hidden="true">
      <span class="cursor-shape"></span>
      <span class="cursor-label"></span>
    </div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
