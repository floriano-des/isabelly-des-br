---
import { getMedia } from '../lib/media';
import { socials, type Lang } from '../lib/site';
import HomePicture from './HomePicture.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pt = lang === 'pt';
const imageSizes = '(max-width: 44rem) 90vw, 30vw';
const action = pt ? 'ver post' : 'view post';
const posts = [
  {
    url: 'https://www.instagram.com/p/DbI83krAAL0/',
    context: pt ? 'Branding além da aparência' : 'Branding beyond appearances',
    cover: getMedia('instagram-marca-bonita'),
    alt: pt
      ? 'Gato preto ao lado da frase “Sua marca pode ser bonita. Mas será que isso é suficiente?” em um fundo roxo.'
      : 'A black cat on purple next to the words “Your brand can be beautiful. But is that enough?” in Portuguese.',
  },
  {
    url: 'https://www.instagram.com/p/Dfua3aTGy4V/',
    context: pt ? 'Identidade visual de Isys Karoline' : 'Visual identity for Isys Karoline',
    cover: getMedia('instagram-isys-capa'),
    alt: pt
      ? 'Atleta de roupa azul em movimento, com o símbolo da marca e a assinatura “Isys Karoline | Personal e Pilates”.'
      : 'An athlete in blue in motion, overlaid with the Isys Karoline logo and the words “Personal e Pilates”.',
  },
  {
    url: 'https://www.instagram.com/p/DcEWmpgkT9d/',
    context: pt ? 'Fundamentos do design' : 'Design fundamentals',
    cover: getMedia('instagram-fundamentos-capa'),
    alt: pt
      ? 'Personagem de máscara com um cutelo ao lado da pergunta “Você faria sua cirurgia com um açougueiro?”.'
      : 'A masked figure with a cleaver beside the question “Would you have surgery with a butcher?” in Portuguese.',
  },
];
---

<section id="instagram" class="instagram-section" aria-labelledby="instagram-heading">
  <div class="instagram-heading">
    <h2 id="instagram-heading">{pt ? 'No meu' : 'From my'} <em>Instagram</em></h2>
    <a class="instagram-profile" href={socials.Instagram}>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
        <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6" />
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
        <circle cx="17.5" cy="6.8" r="1" fill="currentColor" />
      </svg>
      @bella_designbr
    </a>
  </div>
  <ul class="instagram-posts">
    {posts.map(post => (
      <li>
        <a class="instagram-post" href={post.url}>
          <div class="instagram-art">
            <HomePicture asset={post.cover} alt={post.alt} lang={lang} sizes={imageSizes} />
          </div>
          <span class="instagram-action">{action}<span class="sr-only"> · {post.context}</span></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .instagram-section {
    color: var(--texto);
    background: var(--noite-profunda);
    border-top: 1px solid var(--rule);
    padding: clamp(4.5rem, 8vw, 10rem) clamp(1.25rem, 5vw, 7.5rem);
  }
  .instagram-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 3.4vw, 4rem);
  }
  .instagram-heading h2 {
    margin: 0;
    font: 400 clamp(2.8rem, 5.85vw, 7.2rem)/.99 var(--display);
    letter-spacing: -.035em;
  }
  .instagram-heading em { color: #dac4ec; font: italic 500 1em/.99 var(--serif); }
  .instagram-profile {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    min-height: 44px;
    color: var(--texto);
    font: 400 .875rem/1.3 var(--mono);
    text-underline-offset: .25em;
  }
  .instagram-profile:hover { text-decoration: underline; }
  .instagram-posts {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.9vw, 2.5rem);
    margin: 0;
    padding: 0;
  }
  .instagram-post { display: block; color: inherit; text-decoration: none; }
  .instagram-art :global(picture), .instagram-art :global(img) { display: block; width: 100%; height: auto; }
  .instagram-art :global(img) { object-fit: contain; }
  .instagram-action {
    display: inline-block;
    margin-top: .85rem;
    padding-block: .15rem;
    font: 500 1rem/1.4 var(--sans);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .2em;
  }
  .instagram-post:is(:hover, :focus-visible) .instagram-action { color: #dac4ec; }
  @media (max-width: 44rem) {
    .instagram-posts { grid-template-columns: minmax(0, 1fr); gap: 2.4rem; }
    .instagram-heading { display: grid; gap: .45rem; }
    .instagram-profile { justify-self: start; }
  }
</style>
