---
import { projects, type CaseLanguage } from '../lib/case-content';
import { copy } from '../lib/site';
import WorkGrid from './WorkGrid.astro';

interface Props { lang: CaseLanguage }
const { lang } = Astro.props;
const t = copy[lang];
---

<div class="work-index">
  <header class="work-intro">
    <p class="case-label">{t.work}</p>
    <h1>{t.portfolio.intro}</h1>
  </header>
  <WorkGrid {lang} {projects} />
</div>
