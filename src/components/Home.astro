---
import seed from '../../docs/briefing/projetos.seed.json';
import { projects } from '../lib/case-content';
import { getCover, getPhoto } from '../lib/media';
import { copy, pathFor, socials, type Lang } from '../lib/site';
import HomePicture from './HomePicture.astro';
import WorkGrid from './WorkGrid.astro';
import '../styles/home.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const about = pathFor(lang, 'about');
const portrait = getPhoto(1);
const sizes = '(max-width: 640px) 58vw, (max-width: 1000px) 37vw, 24vw';
const services = en
  ? ['Visual identity', 'Social media', 'Branding', 'Print design', 'Illustration', 'Video']
  : ['Identidade visual', 'Social media', 'Branding', 'Material gráfico', 'Ilustração', 'Vídeo'];
const featured = seed.home.destaques.map(slug => projects.find(project => project.slug === slug)!);
const portraitAlt = en ? 'Isabelly Lima wearing glasses against a purple damask backdrop.' : 'Isabelly Lima de óculos, diante de um fundo adamascado roxo.';
const serviceHeading = copy[lang].servicesHint;
const sectionHeading = en ? 'Selected work' : 'Trabalhos selecionados';
const ringText = en ? 'CLICK · MEOW · CLICK · MEOW · ' : 'CLIQUE · MIAU · CLIQUE · MIAU · ';
---
<div class="isa-home" data-isa-home>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-stage">
      <div class="hero-grid" aria-hidden="true">
        <span class="hero-vline"></span><span class="hero-hline"></span>
        <div class="hero-orbit-system">
          <i class="hero-orbit orbit-inner"></i><i class="hero-orbit orbit-main"></i><i class="hero-orbit orbit-outer"></i>
          <i class="orbit-glint glint-north"></i><i class="orbit-glint glint-south"></i>
        </div>
      </div>
      <div class="hero-edition"><span class="home-star" aria-hidden="true">✦</span> {en ? 'Portfolio' : 'Portfólio'} <span class="edition-rule"></span> 2026</div>
      <p class="hero-profession">{en ? 'Graphic designer' : 'Designer gráfica'}<br /><span>&amp; {en ? 'illustrator' : 'ilustradora'}</span></p>
      <nav class="hero-index" aria-label={en ? 'Explore the seven projects' : 'Explore os sete projetos'}>
        {seed.cases.map((c) => <a href={pathFor(lang, 'case', c.slug)} aria-label={`${String(c.ordem).padStart(2, '0')} · ${c.titulo[lang]}`}>
          <span>{String(c.ordem).padStart(2, '0')}</span><i aria-hidden="true">{c.titulo[lang]}</i>
        </a>)}
      </nav>
      <div class="hero-portrait-place">
        <div class="hero-portrait-drift">
          <figure class="hero-portrait">
            <div class="hero-frame-content" data-home-frame>
              <div class="hero-photo" data-slide="0"><HomePicture asset={portrait} lang={lang} alt={portraitAlt} sizes={sizes} eager /></div>
              <template data-home-frames>
                {featured.map((item, i) => <div class="hero-photo" data-slide={i + 1} hidden><HomePicture asset={getCover(item.slug, 'square')} lang={lang} alt="" sizes="(max-width: 640px) min(65vw, 40svh, 323px), (max-width: 1000px) min(42vw, 48svh), min(27vw, 49svh, 478px)" /></div>)}
              </template>
            </div>
          </figure>
        </div>
      </div>
      <h1 id="home-title" class="hero-name" aria-label="Isabelly Lima">
        <span class="hero-first" aria-hidden="true"><span>Isabelly</span></span>
        <span class="hero-last" aria-hidden="true"><span>Lima</span></span>
      </h1>
      <button type="button" class="hero-pause" data-pause-slides hidden aria-pressed="false"
        aria-label={en ? 'Pause image changes' : 'Pausar a troca de imagens'} data-play-label={en ? 'Resume image changes' : 'Retomar a troca de imagens'}>
        <span aria-hidden="true">Ⅱ</span>
      </button>
      <div class="hero-lower">
        <a class="hero-explore" href="#selecionados">
          <span class="explore-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 4v15m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.3"/></svg></span>
          {en ? 'View work' : 'Ver trabalhos'}
        </a>
        <div class="hero-aside">
          <a class="hero-seal" href={about} aria-label={ringText + (en ? 'Meet Isabelly' : 'Conheça Isabelly')}>
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <defs><path id="hero-seal-type" d="M50 50m-37 0a37 37 0 1 1 74 0a37 37 0 1 1-74 0"/></defs>
              <text><textPath href="#hero-seal-type" textLength="231" lengthAdjust="spacing">{ringText}</textPath></text>
            </svg>
            <img src="/cursor/gato-lavanda.svg" alt="" width="96" height="96" />
          </a>
          <p>{services[0]}<br />{services[1]}<br />{services[4]}</p>
        </div>
      </div>
    </div>
    <div class="hero-bar">
      <div class="hero-time"><span aria-hidden="true" class="location-mark"></span>Palmital · SP <time data-clock></time></div>
      <div class="hero-social">
        {Object.entries(socials).map(([name, url], i) => <>{i > 0 && <span aria-hidden="true">·</span>}<a href={url}>{name}</a></>)}
      </div>
      <div class="hero-languages" aria-label={en ? 'Language' : 'Idioma'}>
        <a href="/" lang="pt-BR" hreflang="pt-BR" aria-current={en ? undefined : 'page'}>PT</a>
        <span>/</span><a href="/en/" lang="en" hreflang="en" aria-current={en ? 'page' : undefined}>EN</a>
      </div>
    </div>
  </section>

  <section id="servicos" class="home-services" aria-labelledby="services-heading">
    <h2 class="home-label" id="services-heading">{serviceHeading}</h2>
    <script is:inline data-astro-rerun>
      (() => {
        const section = document.currentScript?.closest('.home-services');
        if (!section || !('IntersectionObserver' in window)) return;
        section.dataset.fonts = 'pending';
        const observer = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) return;
          delete section.dataset.fonts;
          observer.disconnect();
        }, { rootMargin: '-1px 0px' });
        observer.observe(section);
        document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
      })();
    </script>
    <ul class="home-visually-hidden">{services.map(service => <li>{service}</li>)}</ul>
    <div class="service-lettering" aria-hidden="true">
      <div class="service-line"><span data-letters>{services[0]}</span><svg class="service-star" viewBox="0 0 80 80" fill="currentColor"><path d="m40 0 4.6 28.9 23.7-17.2-17.2 23.7L80 40l-28.9 4.6 17.2 23.7-23.7-17.2L40 80l-4.6-28.9-23.7 17.2 17.2-23.7L0 40l28.9-4.6-17.2-23.7 23.7 17.2z"/></svg><span class="service-soft" data-glow={services[1]}><span data-letters>{services[1]}</span></span></div>
      <div class="service-line"><span class="service-hand"><span data-letters>{services[2]}</span><svg viewBox="0 0 220 12" preserveAspectRatio="none" fill="none"><path pathLength="1" d="M2 10C44 3 117 2 218 4" stroke="currentColor" stroke-width="2"/></svg></span><span data-letters>{services[3]}</span></div>
      <div class="service-line"><span data-letters>{services[4]}</span><span class="service-amp"><span>&amp;</span><span>&amp;</span></span><span data-letters>{services[5]}</span></div>
    </div>
  </section>

  <section id="selecionados" class="featured-work" aria-labelledby="featured-title">
    <h2 id="featured-title">{sectionHeading}</h2>
    <WorkGrid {lang} projects={featured} featured />
  </section>
  <template id="home-intro-content">
    <div class="home-intro" aria-hidden="true">
      <div class="intro-greeting"><i></i><span>{en ? 'Hey!' : 'Oi!'}</span><i></i></div>
      <div class="intro-bubbles">{Array.from({ length: 15 }, (_, i) => <i style={`--bx:${(i % 5) * 24 - 1}vw;--by:${Math.floor(i / 5) * 43 + (i % 3) * 3}vh`}></i>)}</div>
    </div>
  </template>
</div>
<script>
  import '../scripts/home';
</script>
